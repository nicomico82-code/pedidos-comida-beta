{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pedidos-comida-admin-beta",
  "main": "src/admin-worker.ts",
  "compatibility_date": "2026-07-29",
  "observability": { "enabled": true },
  "vars": { "APP_NAME": "Tu Negocio - Pedidos", "APP_TIMEZONE": "America/Santiago", "BUSINESS_LOCATION": "Tu ciudad", "ENVIRONMENT": "beta" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "pedidos-comida-beta-db", "database_id": "1ff9094d-37ba-439a-a9ea-1ae6de0b4a96", "migrations_dir": "drizzle-reservas" }]
}
